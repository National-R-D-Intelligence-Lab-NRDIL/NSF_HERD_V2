# Copy this file to .env and fill in values before running docker compose up

# Postgres
POSTGRES_USER=herd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=herd_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed automatically by the API — do not set manually unless overriding
# DATABASE_URL=postgresql://herd:changeme@localhost:5432/herd_db

# LLM / AI
GEMINI_API_KEY=

# Supabase Auth (same credentials as nsf-herd-mvp)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase service_role key -- Settings > API > service_role in the Supabase
# dashboard. Grants full admin access to the Supabase project (bypasses all
# row-level security, can create/delete any user). Used ONLY server-side by
# the admin router (api/routers/admin.py) to power Kalyan's internal
# user-management page. Never commit this value, never expose it to the
# frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=
