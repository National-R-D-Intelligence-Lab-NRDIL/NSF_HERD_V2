# Copy this file to .env and fill in values before running docker compose up

# Postgres
POSTGRES_USER=herd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=herd_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed automatically by the API — do not set manually unless overriding
# DATABASE_URL=postgresql://herd:changeme@localhost:5432/herd_db

# LLM / AI
GEMINI_API_KEY=

# Supabase Auth (same credentials as nsf-herd-mvp)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# From Supabase dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=
